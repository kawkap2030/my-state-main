{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "منظومة إحصائيات الأدوية والمستلزمات الطبية",
  "version": "0.1.0",
  "identifier": "com.mystats.drugapp",
  "mainBinaryName": "drug-stats",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/kawkab_32x32.png",
      "icons/kawkab_128x128.png",
      "icons/kawkab_128x128@2x.png",
      "icons/kawkab_256x256.png",
      "icons/kawkab.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": true
      }
    }
  }
}
